<Window
    x:Class="FaraBotModerator.Views.PokemonRosterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d"
    Title="FaraBotModeratorPokemonRoster"
    Height="600"
    Width="1100"
    MinHeight="300"
    MinWidth="640"
    Icon="/Resources/app.ico"
    ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" Margin="8,0,0,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 登録データ（ポケモンシリーズ）の一覧。読むだけで、登録・削除はチャットのコマンドかサイトで行う -->
    <GroupBox TextBlock.Foreground="Black">
        <GroupBox.Header>
            <TextBlock Text="FaraBotPokemonRoster" Foreground="White" />
        </GroupBox.Header>
        <DockPanel Margin="5">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="RosterGameComboBox" Width="280" Height="30"
                          VerticalAlignment="Center" Foreground="Black" DisplayMemberPath="DisplayName"
                          SelectionChanged="RosterGameComboBox_SelectionChanged" />
                <Button x:Name="RosterReloadButton" Content="再読み込み" Width="110" Height="30"
                        Margin="10,0,0,0" Click="RosterReloadButton_Click" />
                <TextBlock x:Name="RosterStatusTextBlock" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="Gray" TextWrapping="Wrap" MaxWidth="560" MinWidth="560" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="150" />
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="RosterPokemonDataGrid" Grid.Column="0"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          materialDesign:DataGridAssist.CellPadding="8 6"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 6"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" MinWidth="60" />
                        <DataGridTextColumn Header="ポケモン" Binding="{Binding Name}" Width="*" MinWidth="100" />
                        <DataGridTextColumn Header="性格" Binding="{Binding Nature}" Width="95" MinWidth="95" />
                        <DataGridTextColumn Header="努力値" Binding="{Binding EVs}" Width="*" MinWidth="100" />
                        <DataGridTextColumn Header="特性" Binding="{Binding Ability}" Width="*" MinWidth="90" />
                        <DataGridTextColumn x:Name="RosterTeraColumn" Header="テラス" Binding="{Binding TeraType}" Width="95" MinWidth="95" />
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" />
                <DataGrid x:Name="RosterTeamDataGrid" Grid.Column="2"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          materialDesign:DataGridAssist.CellPadding="8 6"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 6"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="チーム" Binding="{Binding Number}" Width="80" MinWidth="80" />
                        <DataGridTextColumn Header="状態" Binding="{Binding Active}" Width="70" MinWidth="70" />
                        <DataGridTextColumn Header="メンバー（#登録 ID と持ち物）" Binding="{Binding Members}" Width="*" MinWidth="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
    </GroupBox>
</Window>
