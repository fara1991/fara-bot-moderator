<Window
    x:Class="FaraBotModerator.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d"
    Title="FaraBotModerator"
    Height="600"
    Width="1100"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Left="0"
    Top="0"
    Closed="MainWindow_Closed"
    Icon="/Resources/app.ico"
    ResizeMode="CanMinimize">
    <ToolTipService.InitialShowDelay>1000</ToolTipService.InitialShowDelay>
    <ToolTipService.ShowDuration>10000</ToolTipService.ShowDuration>
    <Window.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" Margin="8,0,0,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Grid Margin="5">
                            <Path Data="M 0,10 L 10,0 L 20,10 Z" Fill="#FF666666" HorizontalAlignment="Left"
                                  Margin="10,0,0,0" VerticalAlignment="Top" />
                            <Border Background="#FF666666" CornerRadius="5" Margin="0,10,0,0" Padding="10,5">
                                <ContentPresenter TextBlock.Foreground="White" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="MenuTabControl">
            <TabItem x:Name="MainSettingsTabItem" Header="Main Settings">
                <Canvas x:Name="MainSettingsCanvas" Background="#FFE5E5E5">
                    <GroupBox x:Name="TwitchGroupBox" HorizontalAlignment="Center" Height="495"
                              Canvas.Left="10" Canvas.Top="10" VerticalAlignment="Center" Width="550">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Twitch" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Margin="5,0,0,0"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click">
                                    <Button.ToolTip>
                                        <ToolTip Content="Twitchへの接続と基本設定" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="White" />
                                </Button>
                            </StackPanel>
                        </GroupBox.Header>
                        <Canvas x:Name="TwitchCanvas" TextBlock.Foreground="Black">
                            <CheckBox x:Name="BouyomiChanConnectCheckBox" Content="BouyomiChanConnect" IsChecked="True"
                                      HorizontalAlignment="Center" Canvas.Top="341" VerticalAlignment="Top" />
                            <Label x:Name="TwitchConnectionStateLabel" Content="State: Disconnect"
                                   HorizontalAlignment="Center" Canvas.Top="364" VerticalAlignment="Top" />
                            <Button x:Name="TwitchPageButton" Content="TwitchPage" Height="30" Width="105"
                                    HorizontalAlignment="Left" Canvas.Left="202" Canvas.Top="361"
                                    VerticalAlignment="Center" Click="TwitchPageButton_Click" />
                            <Button x:Name="TwitchConnectionButton" Content="Connect" Height="30" Width="105"
                                    HorizontalAlignment="Left" Canvas.Left="311" Canvas.Top="361"
                                    VerticalAlignment="Center" Click="TwitchConnectionButton_Click" />
                            <Button x:Name="TwitchDisconnectButton" Content="Disconnect" Height="30" Width="105"
                                    HorizontalAlignment="Left" Canvas.Left="420" Canvas.Top="361"
                                    VerticalAlignment="Center" Click="TwitchDisconnectButton_Click" />
                            <GroupBox x:Name="TwitchClientGroupBox" HorizontalAlignment="Center"
                                      Height="120" VerticalAlignment="Top" Width="533">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Client" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Margin="5,0,0,0"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Bottom"
                                                ToolTipService.HorizontalOffset="-10"
                                                Click="HelpButton_Click">
                                            <Button.ToolTip>
                                                <ToolTip Content="Twitchチャットクライアントの設定" />
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                     Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Canvas x:Name="TwitchClientCanvas" TextBlock.Foreground="Black">
                                    <StackPanel Orientation="Horizontal" Canvas.Top="0">
                                        <Label x:Name="TwitchClientUserNameLabel" Content="UserName" Height="25"
                                               Background="{x:Null}" Width="83" HorizontalAlignment="Center"
                                               VerticalAlignment="Top" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Margin="-8,0,0,0"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Bottom"
                                                ToolTipService.HorizontalOffset="-10"
                                                Click="HelpButton_Click">
                                            <Button.ToolTip>
                                                <ToolTip Content="Twitchにログインするときの名前" />
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                     Foreground="Gray" />
                                        </Button>
                                    </StackPanel>
                                    <TextBox x:Name="TwitchClientUserNameTextBox" TextWrapping="Wrap" Width="420"
                                             Height="25" HorizontalAlignment="Left" Canvas.Left="100"
                                             VerticalAlignment="Top" Canvas.Top="0" />

                                    <StackPanel Orientation="Horizontal" Canvas.Top="34">
                                        <Label x:Name="TwitchClientDisplayNameLabel" Content="DisplayName" Height="25"
                                               Background="{x:Null}" Width="83" HorizontalAlignment="Center"
                                               VerticalAlignment="Top" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Margin="-8,0,0,0"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Bottom"
                                                ToolTipService.HorizontalOffset="-10"
                                                Click="HelpButton_Click">
                                            <Button.ToolTip>
                                                <ToolTip Content="Twitchの自分のページで表示される名前" />
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                     Foreground="Gray" />
                                        </Button>
                                    </StackPanel>
                                    <TextBox x:Name="TwitchClientDisplayNameTextBox" TextWrapping="Wrap" Width="420"
                                             Height="25" HorizontalAlignment="Left" Canvas.Left="100" Canvas.Top="34"
                                             VerticalAlignment="Top" />
                                </Canvas>
                            </GroupBox>
                            <GroupBox x:Name="TwitchApiGroupBox" HorizontalAlignment="Center" Height="187"
                                      Canvas.Top="149" VerticalAlignment="Top" Width="533">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="API" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Margin="5,0,0,0"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Bottom"
                                                ToolTipService.HorizontalOffset="-10"
                                                Click="HelpButton_Click">
                                            <Button.ToolTip>
                                                <ToolTip Content="Twitch API連携の設定" />
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                     Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Canvas x:Name="TwitchApiCanvas" TextBlock.Foreground="Black">
                                    <StackPanel Orientation="Horizontal" Canvas.Top="0">
                                        <Label x:Name="TwitchApiClientIdLabel" Content="ClientId"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Height="25" Background="{x:Null}" Width="83" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Margin="-8,0,0,0"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Bottom"
                                                ToolTipService.HorizontalOffset="-10"
                                                Click="HelpButton_Click">
                                            <Button.ToolTip>
                                                <ToolTip Content="Twitch API Client ID" />
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                     Foreground="Gray" />
                                        </Button>
                                    </StackPanel>
                                    <PasswordBox x:Name="TwitchApiClientIdPasswordBox" HorizontalAlignment="Left"
                                                 VerticalAlignment="Center" Width="415" Height="25" Canvas.Left="100" />

                                    <StackPanel Orientation="Horizontal" Canvas.Top="30">
                                        <Label x:Name="TwitchApiClientSecretLabel" Content="ClientSecret"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Height="25"
                                               Width="83" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Margin="-8,0,0,0"
                                                ToolTipService.InitialShowDelay="0"
                                                ToolTipService.Placement="Bottom"
                                                ToolTipService.HorizontalOffset="-10"
                                                Click="HelpButton_Click">
                                            <Button.ToolTip>
                                                <ToolTip Content="Twitch API Client Secret" />
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                                     Foreground="Gray" />
                                        </Button>
                                    </StackPanel>
                                    <PasswordBox x:Name="TwitchApiClientSecretPasswordBox" HorizontalAlignment="Center"
                                                 VerticalAlignment="Top" Width="415" Height="25" Canvas.Left="100"
                                                 Canvas.Top="30" />
                                    <Canvas x:Name="TwitchApiNotificationCanvas" Height="39" Width="355"
                                            Canvas.Top="96"
                                            HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Width="355"
                                                   Height="15" Text="※Your API AccessToken has expired."
                                                   Foreground="Red"
                                                   Canvas.Top="1" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Width="405"
                                                   Canvas.Top="19" Height="30"
                                                   Text="　Please press the Authorize button to get the Token."
                                                   Foreground="Red" TextWrapping="Wrap" />
                                    </Canvas>
                                    <TextBlock x:Name="TwitchApiExpireDateTimeTextBlock" Canvas.Left="310"
                                               TextWrapping="Wrap" Text="Token expiration: 2023/01/01 12:00:00"
                                               Canvas.Top="75" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Height="20" Width="205" />
                                    <Button x:Name="TwitchApiAuthorizeButton" Content="Authorize"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Height="30"
                                            Width="105"
                                            Canvas.Left="410" Canvas.Top="100" Click="TwitchApiAuthorizeButton_Click" />
                                </Canvas>
                            </GroupBox>
                        </Canvas>
                    </GroupBox>
                    <GroupBox x:Name="WebViewGroupBox" HorizontalAlignment="Left" Height="493"
                              Canvas.Left="565" Canvas.Top="10" VerticalAlignment="Center" Width="510">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="WebView" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Margin="5,0,0,0"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click">
                                    <Button.ToolTip>
                                        <ToolTip Content="Twitchサイトを表示する内蔵ブラウザ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="White" />
                                </Button>
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid Background="White">
                            <wpf:WebView2 x:Name="FaraBotModeratorWebView"
                                          NavigationCompleted="FaraBotModeratorWebView_NavigationCompleted"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </GroupBox>
                </Canvas>
            </TabItem>
            <TabItem x:Name="ReactionEventSettingsTabItem" Header="Reaction Event Settings">
                <Canvas x:Name="ReactionEventSettingsCanvas" Background="#FFE5E5E5">
                    <GroupBox x:Name="ReactionEventSettingsGroupBox" HorizontalAlignment="Left" Height="255"
                              Canvas.Left="10" Canvas.Top="10" VerticalAlignment="Top" Width="1065">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Event Notification Settings" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Margin="5,0,0,0"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click">
                                    <Button.ToolTip>
                                        <ToolTip Content="各種イベント（フォロー、レイド等）発生時の通知設定" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="White" />
                                </Button>
                            </StackPanel>
                        </GroupBox.Header>
                        <Canvas x:Name="ReactionEventSettingsGroupBoxCanvas" TextBlock.Foreground="Black">
                            <Grid x:Name="FollowGrid" HorizontalAlignment="Left" Height="30" Canvas.Left="0"
                                  Canvas.Top="0"
                                  VerticalAlignment="Center" Width="1040" TextBlock.Foreground="Black">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="770" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="FollowEventCheckBox" Content="Follow" Height="30" Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Grid.Column="1"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button.ToolTip>
                                        <ToolTip Content="誰かがフォローした時に送信するメッセージ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="Gray" />
                                </Button>
                                <TextBox x:Name="FollowEventTextBox" TextWrapping="Wrap" Height="30" Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Text="{}{followerName}, thanks follow. Channel URL: {followerChannelUrl}" />
                                <Button x:Name="FollowTestButton" Content="Test Send" Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Width="120" Height="30" Click="FollowTestButton_Click"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <Grid x:Name="RaidGrid" HorizontalAlignment="Left" Height="30" Canvas.Left="0"
                                  Canvas.Top="35"
                                  VerticalAlignment="Center" Width="1040" TextBlock.Foreground="Black">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="770" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RaidEventCheckBox" Content="Raid" Height="30" Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Grid.Column="1"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button.ToolTip>
                                        <ToolTip Content="誰かがレイドしてくれた時に送信するメッセージ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="Gray" />
                                </Button>
                                <TextBox x:Name="RaidEventTextBox" TextWrapping="Wrap" Height="30" Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Text="Welcome raiders, thanks raid {raiderName}. Channel URL: {raiderChannelUrl}" />
                                <Button x:Name="RaidTestButton" Content="Test Send" Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Width="120" Height="30" Click="RaidTestButton_Click"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <Grid x:Name="SubscriptionGrid" HorizontalAlignment="Left" Height="30" Canvas.Left="0"
                                  Canvas.Top="70"
                                  VerticalAlignment="Center" Width="1040" TextBlock.Foreground="Black">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="770" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SubscriptionEventCheckBox" Content="Subscription" Height="30"
                                          Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Grid.Column="1"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button.ToolTip>
                                        <ToolTip Content="誰かがサブスクライブしてくれた時に送信するメッセージ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="Gray" />
                                </Button>
                                <TextBox x:Name="SubscriptionEventTextBox" TextWrapping="Wrap" Height="30"
                                         Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Text="{}{subscriberName}, thanks subscription {totalSubscriptionMonth} time." />
                                <Button x:Name="SubscriptionTestButton" Content="Test Send" Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Width="120" Height="30" Click="SubscriptionTestButton_Click"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <Grid x:Name="BitsGrid" HorizontalAlignment="Left" Height="30" Canvas.Left="0"
                                  Canvas.Top="105"
                                  VerticalAlignment="Center" Width="1040" TextBlock.Foreground="Black">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="770" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="BitsEventCheckBox" Content="Bits" Height="30" Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Grid.Column="1"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button.ToolTip>
                                        <ToolTip Content="誰かがビッツ（チアー）を投げてくれた時に送信するメッセージ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="Gray" />
                                </Button>
                                <TextBox x:Name="BitsEventTextBox" TextWrapping="Wrap" Height="30" Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Text="{}{bitsSendUserName}, thanks {bitsAmount} bits." />
                                <Button x:Name="BitsTestButton" Content="Test Send" Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Width="120" Height="30" Click="BitsTestButton_Click"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <Grid x:Name="GiftGrid" HorizontalAlignment="Left" Height="30" Canvas.Left="0"
                                  Canvas.Top="140"
                                  VerticalAlignment="Center" Width="1040" TextBlock.Foreground="Black">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="770" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="GiftEventCheckBox" Content="Gift" Height="30" Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Grid.Column="1"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button.ToolTip>
                                        <ToolTip Content="誰かがサブスクギフトを贈ってくれた時に送信するメッセージ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="Gray" />
                                </Button>
                                <TextBox x:Name="GiftEventTextBox" TextWrapping="Wrap" Height="30" Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Text="{}{giftedUserName}, thanks gift present." />
                                <Button x:Name="GiftTestButton" Content="Test Send" Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Width="120" Height="30" Click="GiftTestButton_Click"
                                        HorizontalAlignment="Right" />
                            </Grid>
                            <Grid x:Name="ChannelPointGrid" HorizontalAlignment="Left" Height="30" Canvas.Left="0"
                                  Canvas.Top="175" VerticalAlignment="Center" Width="1040" TextBlock.Foreground="Black">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="770" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChannelPointEventCheckBox" Content="ChannelPoint" Height="30"
                                          Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Grid.Column="1"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button.ToolTip>
                                        <ToolTip Content="誰かがチャンネルポイントを使用した時に送信するメッセージ" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="Gray" />
                                </Button>
                                <TextBox x:Name="ChannelPointEventTextBox" TextWrapping="Wrap" Height="30"
                                         Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Text="{}{channel Point UserName} used the {channel Point Title} with {cost} channel points" />
                                <Button x:Name="ChannelPointTestButton" Content="Test Send" Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Width="120" Height="30" Click="ChannelPointTestButton_Click"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </Canvas>
                    </GroupBox>

                    <GroupBox x:Name="ReplaceWordsDescriptionGroupBox" HorizontalAlignment="Left" Height="230"
                              Canvas.Left="10" Canvas.Top="275" VerticalAlignment="Top" Width="1065">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Replace Words Description" />
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Margin="5,0,0,0"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.Placement="Bottom"
                                        ToolTipService.HorizontalOffset="-10"
                                        Click="HelpButton_Click">
                                    <Button.ToolTip>
                                        <ToolTip Content="メッセージ内の特定の単語を置き換えるための設定説明" />
                                    </Button.ToolTip>
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="White" />
                                </Button>
                            </StackPanel>
                        </GroupBox.Header>
                        <RichTextBox x:Name="ReplaceNotificationRichTextBox" Height="180"
                                     Width="1040" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" Padding="0,0,0,0" VerticalScrollBarVisibility="Visible"
                                     OpacityMask="Black" Background="{DynamicResource AttentionToActionBrush}"
                                     IsReadOnly="True" Foreground="Black">
                            <FlowDocument>
                                <Paragraph>
                                    <Run
                                        Text="・Follow&#xA;{followedName} -&gt; When followed by a user, replace the userName.&#xA;{followerChannelUrl} -&gt; When twitch events, replace event userChannel.&#xA;&#xA;----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;・Raid&#xA;{raiderName} -&gt; When raid by a user, replace the userName.&#xA;{raiderChannelUrl} -&gt; When raid by a user, replace the channelUrl.&#xA;&#xA;----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;・Subscription&#xA;{subscriberName} -&gt; When subscription by a user, replace the userName.&#xA;{totalSubscriptionMonth} -&gt; When subscription by a user, replace total subscription count.&#xA;&#xA;----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;・Bits&#xA;{bitsAmount} -&gt; When throw bits by a user, replace the bits amount.&#xA;{bitsSendUserName} -&gt; When throw bits by a user, replace the userName.&#xA;&#xA;----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;・Gift&#xA;{giftedUserName} -&gt; When throw gifted by a user, replace the userName.&#xA;&#xA;----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;・ChannelPoint&#xA;{channelPointCost} -&gt; When use channelPoint, replace the number of channelPoints used.&#xA;{channelPointTitle} -&gt;