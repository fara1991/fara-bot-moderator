<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <DocumentationFile></DocumentationFile>
        <Title>FaraBotModerator</Title>
        <Authors>Fara</Authors>
        <Company/>
        <Description>Twitch Bot</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NeutralLanguage>ja-JP</NeutralLanguage>
        <PackageIcon></PackageIcon>
        <StartupObject>FaraBotModerator.App</StartupObject>
        <EnforceCodeStyleInBuild>False</EnforceCodeStyleInBuild>
        <AppDesignerFolder>properties</AppDesignerFolder>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>
        <!-- 手元のビルドの既定のバージョン。リリースでは、Installer/installer.iss の MyAppVersion を -p:Version で渡して上書きする -->
        <Version>0.0.0-dev</Version>
        <!-- ビルドのコミットの番号を、アプリ（バージョン情報）に埋め込まない -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>NU1701;1701;1702;NETSDK1086</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <NoWarn>NU1701;1701;1702;NETSDK1086</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="document\**"/>
        <EmbeddedResource Remove="document\**"/>
        <None Remove="document\**"/>
        <Page Remove="document\**"/>
        <Compile Remove="external\**"/>
        <EmbeddedResource Remove="external\**"/>
        <None Remove="external\**"/>
        <Page Remove="external\**"/>
        <Compile Remove="tests\**"/>
        <EmbeddedResource Remove="tests\**"/>
        <None Remove="tests\**"/>
        <Page Remove="tests\**"/>
        <Content Remove="external\**"/>
        <Resource Include="Resources\app.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- 単体テスト（tests\FaraBotModerator.Tests）から internal のメソッドを呼ぶ -->
        <InternalsVisibleTo Include="FaraBotModerator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DeepL.net" Version="1.14.0"/>
        <PackageReference Include="MaterialDesignThemes" Version="5.2.1"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.3"/>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ポケモンの !poke 系コマンド。git submodule: external/fara-pokemon-battle-assistant -->
        <ProjectReference Include="external\fara-pokemon-battle-assistant\src\FaraPokemonBattleAssistant.Core\FaraPokemonBattleAssistant.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="properties\Settings.Designer.cs">
            <DesignTimeSharedInput>True</DesignTimeSharedInput>
            <AutoGen>True</AutoGen>
            <DependentUpon>Settings.settings</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Update="properties\Settings.settings">
            <Generator>SettingsSingleFileGenerator</Generator>
            <LastGenOutput>Settings.Designer.cs</LastGenOutput>
        </None>
    </ItemGroup>

</Project>
