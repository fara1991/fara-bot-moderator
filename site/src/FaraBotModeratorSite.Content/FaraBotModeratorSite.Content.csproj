<Project Sdk="Microsoft.NET.Sdk">

  <!-- Manual.md と Content/pages.json から、サイトの中身（SiteContentData）を作る。ビルド時だけ使う（ブラウザには載せない） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraBotModeratorSite.Content</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaraBotModeratorSite.Shared\FaraBotModeratorSite.Shared.csproj" />
  </ItemGroup>

</Project>
