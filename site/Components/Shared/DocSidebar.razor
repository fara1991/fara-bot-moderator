@inject ContentService Content

@* ドキュメントの目次（グループごと）。広い画面では左に並べ、狭い画面では折りたたんで「目次」から開く（どちらか一方だけが CSS で表示される） *@
<nav class="doc-nav doc-nav-wide" aria-label="ドキュメントの目次">
    @List
</nav>
<details class="doc-nav doc-nav-narrow">
    <summary>ドキュメントの目次</summary>
    <nav aria-label="ドキュメントの目次（折りたたみ）">
        @List
    </nav>
</details>

@code {
    [Parameter] public string? CurrentSlug { get; set; }

    private RenderFragment List => __builder =>
    {
        foreach (var group in Content.Groups)
        {
            <div class="doc-nav-group">
                <p class="doc-nav-title">@group.Name</p>
                <ul>
                    @foreach (var p in group.Pages)
                    {
                        <li><a href="@p.Url" class="@(p.Slug == CurrentSlug ? "current" : null)" aria-current="@(p.Slug == CurrentSlug ? "page" : null)">@p.Title</a></li>
                    }
                </ul>
            </div>
        }
    };
}
