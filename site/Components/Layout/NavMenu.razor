@inject ContentService Content
@inject IOptions<SiteOptions> Site

<div class="top-row">
    <a class="brand" href="/" aria-label="@Site.Value.Title トップへ">
        <span>@Site.Value.Title</span>
    </a>
</div>

@* 静的 SSR なので、スマホのメニューの開閉は、チェックボックスと CSS で行う（JS なし）。PC のサイドバーの表示・隠すは wwwroot/js/site.js *@
<input type="checkbox" id="nav-toggle" class="navbar-toggler" aria-label="メニューを開く" title="メニュー" />

<div class="nav-scrollable">
    @* スマホでは、ヘッダーが無いので、検索欄とライト・ダークの切り替えは、メニューの中に出す *@
    <div class="mobile-tools">
        <SiteSearch IdPrefix="m" />
        <ThemeToggle />
    </div>
    <nav class="flex-column" aria-label="サイト内の移動">
        <div class="nav-item">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All"><NavIcon Name="home" /><span>ホーム</span></NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/docs" Match="NavLinkMatch.All"><NavIcon Name="list" /><span>ドキュメント一覧</span></NavLink>
        </div>

        @foreach (var group in Content.Groups)
        {
            <div class="nav-section">@group.Name</div>
            @foreach (var p in group.Pages)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="@p.Url"><NavIcon Name="@IconOf(p.Slug)" /><span>@p.Title</span></NavLink>
                </div>
            }
        }

        <div class="nav-section">リンク</div>
        <div class="nav-item">
            <a class="nav-link" href="@Site.Value.ReleasesUrl" target="_blank" rel="noopener noreferrer"><NavIcon Name="download" /><span>ダウンロード（最新版）</span></a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="@Site.Value.RepositoryUrl" target="_blank" rel="noopener noreferrer"><NavIcon Name="code" /><span>GitHub</span></a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="@Site.Value.PokemonSiteUrl" target="_blank" rel="noopener noreferrer"><NavIcon Name="external" /><span>Pokémon Battle Assistant</span></a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="@Site.Value.PortfolioUrl"><NavIcon Name="user" /><span>Fara のポートフォリオ</span></a>
        </div>
    </nav>

</div>

@code {
    /// <summary>ページごとのアイコン（Shared/NavIcon.razor の名前）。新しいページを足したら、ここにも書く（無ければ、アイコンなしで出る）。</summary>
    private static string IconOf(string slug) => slug switch
    {
        "overview" => "book",
        "main-settings" => "sliders",
        "reaction-events" => "bell",
        "windows" => "window",
        "translate" => "translate",
        "game" => "gamepad",
        "timer" => "clock",
        "pokemon" => "terminal",
        "pokemon-my" => "ball",
        "pokemon-team" => "users",
        "pokemon-sync" => "key",
        "pokemon-battle" => "bolt",
        "pokemon-rival" => "history",
        "pokemon-notes" => "alert",
        "faq" => "help",
        "troubleshooting" => "wrench",
        "changelog" => "file",
        _ => "list",
    };
}
