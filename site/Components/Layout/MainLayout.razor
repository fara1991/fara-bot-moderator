@inherits LayoutComponentBase
@inject IOptions<SiteOptions> Site

<a class="skip-link" href="#main-content">本文へスキップ</a>

<div class="page">
    <div class="sidebar" id="site-sidebar">
        <NavMenu />
    </div>

    @* サイドバーを隠しているときだけ（PC）、左上に出る「開く」ボタン。押す処理は wwwroot/js/site.js *@
    <button type="button" class="sidebar-reveal" data-sidebar-toggle aria-controls="site-sidebar" aria-expanded="false" title="サイドバーを表示">
        <span aria-hidden="true">☰</span><span class="visually-hidden">サイドバーを表示</span>
    </button>

    <main id="main-content" tabindex="-1">
        @Body

        <footer class="site-footer">
            <span>© Fara</span>
            <a href="@Site.Value.RepositoryUrl" target="_blank" rel="noopener noreferrer">GitHub で修正を提案する</a>
        </footer>
    </main>
</div>
