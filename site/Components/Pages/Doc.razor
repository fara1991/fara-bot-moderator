@page "/docs/{Slug}"
@inject ContentService Content
@inject IOptions<SiteOptions> Site

@if (doc is null)
{
    <NotFoundContent />
}
else
{
    <PageTitle>@doc.Title | @Site.Value.Title</PageTitle>
    <HeadContent>
        <meta name="description" content="@doc.Description" />
        <meta property="og:title" content="@doc.Title | @Site.Value.Title" />
    </HeadContent>

    <div class="doc-layout">
        <article class="doc-main">
            <p class="breadcrumb"><a href="/docs">ドキュメント</a> <span aria-hidden="true">/</span> @doc.Group</p>
            <h1>@doc.Title</h1>
            <p class="doc-description">@doc.Description</p>
            <div class="prose">@((MarkupString)doc.Html)</div>

            <nav class="doc-pager" aria-label="前後のページ">
                @if (previous is not null)
                {
                    <a class="pager-prev" href="@previous.Url"><small>前のページ</small><span>@previous.Title</span></a>
                }
                @if (next is not null)
                {
                    <a class="pager-next" href="@next.Url"><small>次のページ</small><span>@next.Title</span></a>
                }
            </nav>
        </article>

        @if (doc.Toc.Count > 0)
        {
            <aside class="doc-toc">
                <nav aria-label="このページの目次">
                    <p class="doc-nav-title">このページの内容</p>
                    <ul>
                        @foreach (var item in doc.Toc.Where(t => t.Level <= 3))
                        {
                            <li class="@(item.Level == 3 ? "sub" : null)"><a href="@(doc.Url)#@item.Id">@item.Text</a></li>
                        }
                    </ul>
                </nav>
            </aside>
        }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private DocPage? doc;
    private DocPage? previous;
    private DocPage? next;

    protected override void OnParametersSet()
    {
        doc = Content.Find(Slug);
        if (doc is null)
        {
            // 静的に書き出すときの 404 判定と、検索エンジンへの通知のため、ステータスも 404 にする
            if (HttpContext is not null) HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }
        (previous, next) = Content.Neighbors(doc);
    }
}
