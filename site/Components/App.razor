@inject IOptions<SiteOptions> Site

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#120a22" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Site.Value.Title" />
    <meta property="og:description" content="@Site.Value.Description" />
    <meta name="twitter:card" content="summary" />
    <link href="/css/site.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/images/site-icon.svg" />
    <script src="/js/site.js"></script>
    <script src="/js/search.js" defer></script>
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>
