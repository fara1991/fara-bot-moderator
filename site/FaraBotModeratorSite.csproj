<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraBotModeratorSite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- テストプロジェクト（tests/）のソースを、このプロジェクトに取り込まない -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- Blazor WebAssembly 版の新しいプロジェクト群（src/）のソースも、この静的 SSR のプロジェクトに取り込まない -->
    <Compile Remove="src\**" />
    <EmbeddedResource Remove="src\**" />
    <None Remove="src\**" />
    <Content Remove="src\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\FaraBotModeratorSite.Content\FaraBotModeratorSite.Content.csproj" />
  </ItemGroup>

</Project>
